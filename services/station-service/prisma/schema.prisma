generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model GeneratorBrand {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String   @db.VarChar(100)
  normalizedName String   @unique @map("normalized_name") @db.VarChar(100)
  country        String?  @db.VarChar(100)
  note           String?
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  models   GeneratorModel[]
  stations Station[]

  @@map("generator_brands")
}

model GeneratorModel {
  id                       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  brandId                  String   @map("brand_id") @db.Uuid
  modelName                String   @map("model_name") @db.VarChar(100)
  normalizedModelName      String   @map("normalized_model_name") @db.VarChar(100)
  powerKva                 Decimal? @map("power_kva") @db.Decimal(8, 2)
  fuelType                 String   @default("diesel") @map("fuel_type") @db.VarChar(50)
  suggestedConsumptionRate Decimal? @map("suggested_consumption_rate") @db.Decimal(6, 3)
  suggestedMaxCapacity     Decimal? @map("suggested_max_capacity") @db.Decimal(8, 2)
  note                     String?
  isActive                 Boolean  @default(true) @map("is_active")
  createdAt                DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                DateTime @updatedAt @map("updated_at") @db.Timestamptz

  brand    GeneratorBrand @relation(fields: [brandId], references: [id])
  stations Station[]

  @@unique([brandId, normalizedModelName])
  @@map("generator_models")
}

model Station {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  stationCode          String    @unique @map("station_code") @db.VarChar(50)
  stationName          String    @map("station_name") @db.VarChar(200)
  generatorName        String?   @map("generator_name") @db.VarChar(200)
  address              String?
  latitude             Decimal?  @db.Decimal(10, 7)
  longitude            Decimal?  @db.Decimal(10, 7)
  currentAdminUnitName String?   @map("current_admin_unit_name") @db.VarChar(100)
  legacyAreaName       String?   @map("legacy_area_name") @db.VarChar(100)
  operationAreaName    String?   @map("operation_area_name") @db.VarChar(100)
  brandId              String?   @map("brand_id") @db.Uuid
  modelId              String?   @map("model_id") @db.Uuid
  powerKva             Decimal?  @map("power_kva") @db.Decimal(8, 2)
  fuelType             String    @default("diesel") @map("fuel_type") @db.VarChar(50)
  consumptionRate      Decimal   @map("consumption_rate") @db.Decimal(6, 3)
  maxCapacity          Decimal   @map("max_capacity") @db.Decimal(8, 2)
  notes                String?
  managedByEmployeeId  String?   @map("managed_by_employee_id") @db.Uuid
  isActive             Boolean   @default(true) @map("is_active")
  deactivatedAt        DateTime? @map("deactivated_at") @db.Timestamptz
  deactivationReason   String?   @map("deactivation_reason")
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  brand   GeneratorBrand? @relation(fields: [brandId], references: [id])
  model   GeneratorModel? @relation(fields: [modelId], references: [id])
  manager Employee?       @relation(fields: [managedByEmployeeId], references: [id])

  @@index([stationCode], map: "idx_stations_code")
  @@index([latitude, longitude], map: "idx_stations_latlon")
  @@index([isActive], map: "idx_stations_active")
  @@map("stations")
}

/// Nhân viên hiện trường được gán quản lý trạm. KHÔNG phải tài khoản đăng nhập — chỉ là danh sách
/// tên do admin quản lý, gán vào trạm khi thêm/duyệt (chọn từ dropdown có tìm kiếm).
model Employee {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @db.VarChar(150)
  phone     String?  @db.VarChar(30)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  stations Station[]

  @@index([isActive], map: "idx_employees_active")
  @@map("employees")
}

/// Sự kiện bảo dưỡng máy phát của một trạm — tách khỏi việc đổ nhiên liệu.
model MaintenanceLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  stationId   String   @map("station_id") @db.Uuid
  stationCode String   @map("station_code") @db.VarChar(50)
  performedAt DateTime @map("performed_at") @db.Date
  note        String?
  recordedBy  String?  @map("recorded_by") @db.VarChar(100)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([stationId], map: "idx_maintenance_station")
  @@map("maintenance_logs")
}

/// Ghi vết khi hãng/model máy phát của một trạm bị đổi, để xem lại lịch sử thay máy.
model StationMachineChange {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  stationId    String   @map("station_id") @db.Uuid
  stationCode  String   @map("station_code") @db.VarChar(50)
  oldBrandName String?  @map("old_brand_name") @db.VarChar(200)
  oldModelName String?  @map("old_model_name") @db.VarChar(200)
  newBrandName String?  @map("new_brand_name") @db.VarChar(200)
  newModelName String?  @map("new_model_name") @db.VarChar(200)
  changedBy    String?  @map("changed_by") @db.VarChar(100)
  changedAt    DateTime @default(now()) @map("changed_at") @db.Timestamptz

  @@index([stationId], map: "idx_machine_change_station")
  @@map("station_machine_changes")
}

/// Đề xuất tạo trạm mới. Nhân viên gửi đề xuất, quản lý/admin duyệt; chỉ khi duyệt mới sinh ra
/// Station thật. Tách bảng riêng để mọi truy vấn trạm hiện có không phải lọc bỏ bản nháp.
model StationRequest {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  stationCode          String    @map("station_code") @db.VarChar(50)
  stationName          String    @map("station_name") @db.VarChar(200)
  generatorName        String?   @map("generator_name") @db.VarChar(200)
  address              String?
  latitude             Decimal?  @db.Decimal(10, 7)
  longitude            Decimal?  @db.Decimal(10, 7)
  currentAdminUnitName String?   @map("current_admin_unit_name") @db.VarChar(100)
  legacyAreaName       String?   @map("legacy_area_name") @db.VarChar(100)
  operationAreaName    String?   @map("operation_area_name") @db.VarChar(100)
  brandId              String?   @map("brand_id") @db.Uuid
  modelId              String?   @map("model_id") @db.Uuid
  powerKva             Decimal?  @map("power_kva") @db.Decimal(8, 2)
  fuelType             String    @default("diesel") @map("fuel_type") @db.VarChar(50)
  consumptionRate      Decimal   @map("consumption_rate") @db.Decimal(6, 3)
  maxCapacity          Decimal   @map("max_capacity") @db.Decimal(8, 2)
  initialFuel          Decimal   @default(0) @map("initial_fuel") @db.Decimal(8, 2)
  managedByEmployeeId  String?   @map("managed_by_employee_id") @db.Uuid
  notes                String?

  /// pending → approving (đang giành quyền, thoáng qua) → approved | rejected
  status           String    @default("pending") @db.VarChar(20)
  requestedBy      String    @map("requested_by") @db.VarChar(100)
  requestedAt      DateTime  @default(now()) @map("requested_at") @db.Timestamptz
  reviewedBy       String?   @map("reviewed_by") @db.VarChar(100)
  reviewedAt       DateTime? @map("reviewed_at") @db.Timestamptz
  rejectionReason  String?   @map("rejection_reason")
  /// Đặt khi duyệt thành công — cho phép duyệt lại mà không sinh trạm thứ hai.
  createdStationId String?   @map("created_station_id") @db.Uuid

  @@index([status], map: "idx_station_requests_status")
  @@map("station_requests")
}
