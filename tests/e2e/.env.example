# Copy to .env and fill in. NEVER commit the real .env (see README).
# The passwords here MUST match the accounts seeded into auth_db
# (run: node scripts/seed-test-accounts.mjs — it reads these values).

FRONTEND_URL=http://localhost:5173
GATEWAY_URL=http://localhost:3010/api/

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
MANAGER_USERNAME=manager
MANAGER_PASSWORD=change-me
STAFF_USERNAME=staff
STAFF_PASSWORD=change-me

# Absolute path to the Fuel Management monorepo checkout (used by some helpers)
REPO_PATH=D:\Fuel Management
RUN_MODE=full
ALLOW_WRITE_TESTS=true
