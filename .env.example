# PostgreSQL
POSTGRES_USER=fuelapp
POSTGRES_PASSWORD=fuelapp_secret

# Auth Service
AUTH_SERVICE_PORT=3001
AUTH_JWT_SECRET=change_me_in_production_at_least_32_chars
AUTH_JWT_EXPIRES_IN=8h
AUTH_DATABASE_URL=postgresql://fuelapp:fuelapp_secret@postgres:5432/auth_db

# Station Service
STATION_SERVICE_PORT=3002
STATION_DATABASE_URL=postgresql://fuelapp:fuelapp_secret@postgres:5432/station_db

# Fuel Service
FUEL_SERVICE_PORT=3003
FUEL_DATABASE_URL=postgresql://fuelapp:fuelapp_secret@postgres:5432/fuel_db

# Import/Export Service
IMPORT_EXPORT_SERVICE_PORT=3004
IMPORT_DATABASE_URL=postgresql://fuelapp:fuelapp_secret@postgres:5432/import_db
IMPORT_MAX_FILE_SIZE_MB=10

# Realtime Service
REALTIME_SERVICE_PORT=3005

# Gateway
GATEWAY_PORT=3000
CORS_ORIGIN=http://localhost:5173

# RabbitMQ
RABBITMQ_URL=amqp://fuelapp:fuelapp_secret@rabbitmq:5672

# Internal service URLs (used by services when calling each other)
AUTH_SERVICE_URL=http://auth-service:3001
STATION_SERVICE_URL=http://station-service:3002
FUEL_SERVICE_URL=http://fuel-service:3003
IMPORT_EXPORT_SERVICE_URL=http://import-export-service:3004
REALTIME_SERVICE_URL=http://realtime-service:3005
